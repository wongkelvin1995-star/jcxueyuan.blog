---
export interface Props {
  mood?: 'happy' | 'curious' | 'cheer';
  size?: number;
  className?: string;
}

const { mood = 'happy', size = 88, className = '' } = Astro.props;
---

<svg
  viewBox="0 0 120 130"
  width={size}
  height={Math.round(size * 130 / 120)}
  class={`mochi-art mochi-float ${className}`}
  role="img"
  aria-label="MOCHI · 樱团（机场学院原创知识精灵）"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id="mochiBody" cx="45%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#FFFFFF" />
      <stop offset="80%" stop-color="#FFF4F7" />
      <stop offset="100%" stop-color="#F7DCE6" />
    </radialGradient>
  </defs>

  <!-- Soft shadow -->
  <ellipse cx="60" cy="118" rx="30" ry="6" fill="#57465C" opacity="0.12" />

  <!-- Bunny Ears -->
  <ellipse cx="42" cy="36" rx="10" ry="24" transform="rotate(-10 42 36)" fill="#FFFFFF" stroke="#E5BACB" stroke-width="1.6" />
  <ellipse cx="42" cy="38" rx="5" ry="15" transform="rotate(-10 42 38)" fill="#F2B8CD" opacity="0.7" />
  <ellipse cx="78" cy="36" rx="10" ry="24" transform="rotate(10 78 36)" fill="#FFFFFF" stroke="#E5BACB" stroke-width="1.6" />
  <ellipse cx="78" cy="38" rx="5" ry="15" transform="rotate(10 78 38)" fill="#F2B8CD" opacity="0.7" />

  <!-- Mini Graduation Cap -->
  <g transform="translate(60, 24) rotate(-6)">
    <polygon points="0,-10 22,-2 0,6 -22,-2" fill="#57465C" stroke="#AD557D" stroke-width="1.2" />
    <rect x="-10" y="2" width="20" height="7" rx="3" fill="#57465C" />
    <path d="M18,-1 L22,12" stroke="#E4C69D" stroke-width="2" stroke-linecap="round" />
    <circle cx="22" cy="13" r="2.5" fill="#E4C69D" />
  </g>

  <!-- Round White-Pink Body -->
  <ellipse cx="60" cy="78" rx="36" ry="33" fill="url(#mochiBody)" stroke="#E5BACB" stroke-width="1.8" />

  <!-- Blush -->
  <ellipse cx="38" cy="80" rx="6" ry="3.5" fill="#F2B8CD" opacity="0.75" />
  <ellipse cx="82" cy="80" rx="6" ry="3.5" fill="#F2B8CD" opacity="0.75" />

  <!-- Eyes -->
  {mood === 'cheer' ? (
    <g stroke="#57465C" stroke-width="2.4" fill="none" stroke-linecap="round">
      <path d="M41 72 Q46 66 51 72" />
      <path d="M69 72 Q74 66 79 72" />
    </g>
  ) : (
    <g>
      <circle cx="46" cy="71" r="3.8" fill="#57465C" />
      <circle cx="44.8" cy="69.5" r="1.3" fill="#FFFFFF" />
      <circle cx="74" cy="71" r="3.8" fill="#57465C" />
      <circle cx="72.8" cy="69.5" r="1.3" fill="#FFFFFF" />
    </g>
  )}

  <!-- Cute Mouth -->
  {mood === 'curious' ? (
    <circle cx="60" cy="81" r="2.5" fill="#AD557D" />
  ) : (
    <path d="M55 79 Q60 84 65 79" fill="none" stroke="#AD557D" stroke-width="2" stroke-linecap="round" />
  )}

  <!-- Sakura Hair Ornament -->
  <g transform="translate(86, 52)">
    <circle cx="0" cy="-4" r="3.2" fill="#F2B8CD" />
    <circle cx="4" cy="0" r="3.2" fill="#F2B8CD" />
    <circle cx="-4" cy="0" r="3.2" fill="#F2B8CD" />
    <circle cx="2" cy="4" r="3.2" fill="#F2B8CD" />
    <circle cx="-2" cy="4" r="3.2" fill="#F2B8CD" />
    <circle cx="0" cy="0.5" r="2" fill="#E4C69D" />
  </g>

  <!-- Mini Study Notebook -->
  <g transform="translate(76, 88) rotate(12)">
    <rect x="0" y="0" width="22" height="26" rx="4" fill="#D9D0EB" stroke="#57465C" stroke-width="1.3" />
    <rect x="4" y="5" width="14" height="4" rx="1.5" fill="#FFF8F2" />
    <line x1="4" y1="14" x2="18" y2="14" stroke="#57465C" stroke-width="1.3" opacity="0.6" />
    <line x1="4" y1="19" x2="15" y2="19" stroke="#57465C" stroke-width="1.3" opacity="0.6" />
  </g>
</svg>
